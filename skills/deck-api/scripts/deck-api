#!/usr/bin/env bash
# deck-api — 通过 Codex Deck 唤醒 agent 会话。用法见 `deck-api help`。
set -uo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
# Git Bash/MSYS 的 $$ 不是 Windows pid；Deck 的进程树扫描用 winpid。
PID=$$
if [ -r "/proc/$$/winpid" ]; then
  win=$(cat "/proc/$$/winpid" 2>/dev/null || true)
  [ -n "$win" ] && PID=$win
fi
DECK_HOME="${CODEX_DECK_HOME:-$HOME/.codex-deck}"
INSTALLED="$DECK_HOME/bin/deck-api"

# 各项目里的 skill 拷贝只是入口：Deck 启动时会把与自身版本配套的脚本装到
# ~/.codex-deck/bin/，这里优先转发过去，旧拷贝不会和服务端接口脱节。
# _watch/_poll 是已经 spawn 出来的 watcher 本体，不转发。
if [ -z "${DECK_API_NO_FORWARD-}" ] && [ -f "$INSTALLED" ] && [ "$SELF" != "$INSTALLED" ]; then
  case "${1-}" in
    _watch|_poll) ;;
    *) DECK_API_NO_FORWARD=1 exec bash "$INSTALLED" "$@" ;;
  esac
fi

EXPLICIT_URL="${DECK_API_URL:-}"
URL="$EXPLICIT_URL"
TOKEN="${DECK_TOKEN-}"
# Each request rediscovers the selected instance so long-running watchers survive address changes.
SELECTED_INSTANCE="${DECK_INSTANCE_ID-}"
LOG_DIR="${DECK_API_LOG_DIR:-${DECK_SEND_LOG_DIR:-${DECK_WAKE_LOG_DIR:-$DECK_HOME/watch}}}"
DONE_RE_DEFAULT='^(COMPLETED|FAILED|CANCELLED|TIMEOUT|OUT_OF_MEMORY|NODE_FAIL|PREEMPTED|BOOT_FAIL|DEADLINE|DONE|EXITED|ERROR|GONE)'
CODE_RE='^[a-z0-9][a-z0-9-]{1,30}$'

usage() { # 不带参数打印总览，带主题打印对应段落
  case "${1-}" in
    create)
      cat <<'EOF'
deck-api create [<agentId> | --preset name] [--detached] [--name title] [--file path|-] -- <任务>
    创建独立会话并绑定来源，返回稳定会话地址与持久受理回执。
    受理后可继续当前工作；receive 在当前回合领取来信，无需先结束回合。
    最终答复和执行失败自动进入来源收件箱，不需要额外 send 最终结论。
    --detached 后台静默：结果仍进收件箱，但不单独唤醒来源，使用 receive 领取。
    result / inspect 仅作辅助查询，不代替 receive；历史关系仍保留原通信方式。
    --mode 为历史高级兼容选项，新任务发送不使用 steer/interrupt。
    --cwd dir 指定目标工作目录；--worktree 或 --worktree=base 使用独立 checkout。
    --approval / --sandbox / --permission-mode 只能在用户明确配置的允许集合内选择，不自行提权。
    create 回执的 effectiveConfiguration 显示 value/source；confirmed=false 表示未获适配器确认。
    --session agent:thread 显式指定创建来源；默认由 Deck 识别（无法佐证时必须显式给出）。
    --request-id id 可重放同一次创建，不能改变参数；CLI 自动为本次调用生成。
    presets 列出用户保存的 Agent / 模型 / effort 组合；create --preset name 使用整套组合。
    预设与 --provider / --model / --effort 不能混用；指定 agentId 时必须与预设一致。
    仅用户明确要求时使用 --provider id / --model id / --effort value；否则使用 Deck 默认。
EOF
      ;;
    result|inspect|wait)
      cat <<'EOF'
deck-api result @alias                       读取状态与已保存的本回合最终答复
deck-api inspect @alias [--tail 40]           查看原生会话最近输出（1 至 200 行）
deck-api wait @alias [--timeout 60]           可选脚本等待，0 至 60 秒；超时 timedOut=true
    wait 不标已读，断连/重启不是成功；Agent 默认不用等待。
    也可用 create 返回的完整询问 ID。查询只读，不唤醒来源、不消耗结果，可重复读取。
    result 返回 item、result（turnId/text/completedAt/truncated）、pending。所有模式均可读取。
    item.resultState 为 pending/ready/empty：待同步/可领取/未生成最终文本；空答复不算交付。
    pending 表示回合已结束但原生历史尚未同步；运行中或失败时 result 为 null，请看状态/error。
    inspect 返回近期回复、命令输出和文件路径，不包含推理；原生后端不可用时会报错。
    result 的截断由 truncated 标记；全文保留在原生会话，可用短链接打开。
    不要紧密轮询；先推进独立工作，再按需检查。新任务优先 receive，来源空闲可自动续跑。
EOF
      ;;
    collect)
      cat <<'EOF'
deck-api tasks --unread                      筛选未领取结果/失败/等待变化
deck-api collect @alias [@alias ...]           显式批量领取，最多 100 条
    result 查询不标已读；collect 推进已读指针，结果仍可重复读取。
    这是可选脚本/UI 能力，普通 Agent 流程无需额外执行。
EOF
      ;;
    receive)
      cat <<'EOF'
deck-api receive [--wait 0..60] [--session agent:thread] [--request-id id]
    批量领取当前会话的新消息，默认立即返回；运行中不需要结束回合。
    返回 messages、requestId、hasMore、timedOut；受理/领取不代表模型完成或用户已读。
    网络重试沿用本次请求 ID；不确定工具输出是否收到时，可只读回放：
deck-api receive --replay                     列出最近领取批次
deck-api receive --replay <requestId>         重放原批次，不消费下一批
    回放至少保留 7 天；超时返回空数组，不是任务失败。不要紧密轮询。
EOF
      ;;
    send)
      cat <<'EOF'
deck-api send [--to agent:thread|@alias] [--file path|-] -- <消息>
    不指定目标时发给 create 绑定的来源。
    消息必须放在 -- 之后；旧式 `send <会话别名> <消息>` 不接受。
    --to @alias 指向询问回执；--to @s-xxxxxxx 指向会话本身（由 Deck 在创建时默认分配）。
    两者都不需要完整 thread ID；回执给哪个就用哪个，跨会话协作通常用 @s-…。
    --session agent:thread 指定当前发送会话（不是收件人）；多会话或跨平台时建议显式带上。
    默认持久写入收件箱；运行中不注入，空闲时可批量续跑。receive 可在当前回合取信。
    send 用于进度或问题；最终答复自动交付，不要重复 send 最终结论。
    --request-id 同时适用于默认来源与显式 --to；2xx 不代表对方完成或已读。
    历史关系仍走旧队列，保留 --mode queue|steer|interrupt；新协议拒绝 steer/interrupt。
EOF
      ;;
    stop|kill)
      cat <<'EOF'
deck-api stop @alias [--after-turn|--now|--force] [--session agent:thread]
    （别名 kill）停止没有结束的询问；停止是静默的，不向来源回传失败消息。
    --after-turn 取消排队消息，等当前回合自然结束后标记已停止。
    --now        立即打断当前回合（默认）。
    --force      打断失败时再执行紧急停止；不绕过所有权检查。
    @alias 可以是询问别名（7f3a2c90）或会话别名（@s-xxx）；已结束的询问不能停止。
EOF
      ;;
    delete|del)
      cat <<'EOF'
deck-api delete @alias [--force] [--keep-worktree] [--keep-watchers] [--close-connection] [--session agent:thread]
    （别名 del）删除自己创建的目标会话；别名保留为墓碑。
    正在执行的会话需要先 stop 或加 --force（会先停止再删除）。
    force 不绕过所有权，不丢弃未提交内容；dirty worktree 始终保留并报告。
    默认停止该会话绑定的 watcher；--keep-watchers 保留它们并给出警告。
    默认清理 Deck 创建且无未提交改动的 worktree；dirty worktree 会保留并报告。
    Claude 等需要关闭 Deck 连接的会话，可加 --close-connection。
EOF
      ;;
    archive|unarchive)
      cat <<'EOF'
deck-api archive @alias | deck-api unarchive @alias [--session agent:thread]
    归档是软隐藏：保留原生会话、结果与别名，但不能再 send。
    运行中的会话必须先 stop；归档不会删除任何历史。
EOF
      ;;
    wake|watch|poll)
      cat <<'EOF'
deck-api wake [watch|poll] [@s-alias] [--mode queue|steer|interrupt] [--session agent:thread] [-l label] [-f] -- <command...>
    默认 watch：后台运行阻塞命令，结束后带退出码和末尾输出通知。
    watch 可用 -n lines（默认 40）。
    poll 可用 -i sec（默认 60，最小 5）、-d regex（自定义结束态）、-a（也通知中间状态变化）。
    poll 连续 10 次 SSH 连接失败也会通知；空状态视为 GONE。
    省略别名 自动绑定当前会话；无法确认来源或会话别名属于其他会话时，请用户确认后加 -f。
    watcher 自行后台运行；提交后结束回合，不自行 sleep/轮询。
EOF
      ;;
    *)
      cat <<'EOF'
deck-api [--json] help [create|send|receive|del] 查看通信操作

deck-api create <agentId> -- <任务>          创建独立会话，返回稳定地址
deck-api presets                            列出用户预配置的组合
deck-api create --preset name -- <任务>      使用预设创建会话
deck-api send [--to @s-…] -- <消息>          向收件箱发送；省略目标时发给绑定来源
deck-api receive [--wait 0..60]               在当前回合批量取信
deck-api del @s-…                            安全删除自己创建的目标会话

最终答复自动交付；运行中不注入，空闲时可批量续跑。辅助管理/排障命令如下：

deck-api create …                             创建独立会话并绑定来源（help create 看详情）
deck-api create <agentId> --detached …         独立执行，不自动通知来源
deck-api result @alias / inspect @alias        按需领取结果 / 查看执行输出
deck-api delivery <deliveryId>                查询单条消息的投递状态（不代表已读）
deck-api send …                               向来源或指定会话发消息（help send 看详情）
deck-api stop @alias                          停止未结束的询问（别名 kill，静默不回报）
deck-api delete @alias                        删除原生会话与台账（别名 del，别名保留墓碑）
deck-api archive @alias / unarchive @alias    归档 / 恢复子任务会话
deck-api wake …                               监督外部任务（help wake 看详情）

deck-api agents / sessions（或 tasks）         查看可用 Agent / 创建记录与会话短别名（不是消息正文）
deck-api whoami / list                        确认当前会话 / 查看会话别名与唤醒会话别名
deck-api wake ps / wake stop <pid>            查看 / 主动停止 watcher

queue 等目标空闲；steer 即时追加到目标当前回合（不打断，仅 codex 这类可转向会话支持）；interrupt 停止目标当前回合再发送。
steer 时目标空闲则直接发送；目标回合已变化会失败，可用 --request-id 重试。
create 受理后可继续工作；receive 当前回合取信，不要紧密轮询。
    detached 的结果仍进 inbox，但不会单独唤醒来源。
send 与 wake 共用默认会话别名，分别投递普通消息与任务事件。
后端通过 ${CODEX_DECK_HOME:-$HOME/.codex-deck}/instances/ 自动发现并校验，
可用 DECK_API_URL / DECK_TOKEN 覆盖；可用 DECK_INSTANCE_ID 固定实例。
旧 ask/watch/poll/asks/ps/stop 命令继续兼容。
EOF
      ;;
  esac
}

die() { echo "deck-api: $*" >&2; exit 1; }

new_request_id() {
  if [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  else printf '%s-%s-%s-%s-%s-%s\n' "$(date +%s)" "$PID" "$RANDOM" "$RANDOM" "$RANDOM" "$RANDOM"; fi
}

json_str() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
  s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\010\013\014\016-\037')
  printf '"%s"' "$s"
}

url_encode() {
  local value=$1 encoded='' char hex index
  local LC_ALL=C
  for ((index=0; index<${#value}; index++)); do
    char=${value:index:1}
    case "$char" in [a-zA-Z0-9.~_-]) encoded+="$char" ;;
      *) printf -v hex '%%%02X' "'$char"; encoded+="$hex" ;;
    esac
  done
  printf '%s' "$encoded"
}

# json_field JSON KEY —— 取顶层字符串字段（够用即可，不依赖 jq）。
json_field() {
  printf '%s' "$1" | grep -oE "\"$2\":\"([^\"\\\\]|\\\\.)*\"" | head -n1 |
    sed -E -e "s/^\"$2\":\"//" -e 's/"$//' -e 's/\\n/ /g' -e 's/\\"/"/g' -e 's/\\\\/\\/g'
}

discover() {
  if [ -n "$EXPLICIT_URL" ]; then URL="$EXPLICIT_URL"; return 0; fi
  local file record candidate_url candidate_token expected reply body
  local live=0 matched=0 chosen_url='' chosen_token='' chosen_id='' fallback_url='' fallback_token='' fallback_id=''
  body=$(printf '{"pid":%s,"cwd":%s,"session":%s,"sessionExplicit":%s,"codexThread":%s}' \
    "$PID" "$(json_str "$PWD")" "$(json_str "${session-${CODEX_DECK_SESSION-}}")" "${session_explicit:-false}" "$(json_str "${CODEX_THREAD_ID-}")")
  for file in "$DECK_HOME"/instances/*.json; do
    [ -f "$file" ] || continue
    record=$(cat "$file" 2>/dev/null) || continue
    expected=$(json_field "$record" instanceId)
    [ -z "$SELECTED_INSTANCE" ] || [ "$SELECTED_INSTANCE" = "$expected" ] || continue
    candidate_url=$(json_field "$record" url); candidate_token=$(json_field "$record" token)
    [ -n "$expected" ] && [ -n "$candidate_url" ] || continue
    reply=$(curl -fsS --connect-timeout 2 --max-time 5 -X POST "$candidate_url/api/deck/discover" \
      -H "Content-Type: application/json" -H "Authorization: Bearer ${DECK_TOKEN-$candidate_token}" --data-binary "$body" 2>/dev/null) || continue
    [ "$(json_field "$reply" instanceId)" = "$expected" ] || continue
    live=$((live + 1)); fallback_url=$candidate_url; fallback_token=$candidate_token; fallback_id=$expected
    if [[ $reply =~ \"caller\":[[:space:]]*true ]]; then
      matched=$((matched + 1)); chosen_url=$candidate_url; chosen_token=$candidate_token; chosen_id=$expected
    fi
  done
  if [ "$matched" -eq 1 ]; then
    URL=$chosen_url; TOKEN=${DECK_TOKEN-$chosen_token}; SELECTED_INSTANCE=$chosen_id
  elif [ "$matched" -eq 0 ] && [ "$live" -eq 1 ] && { [ -n "$SELECTED_INSTANCE" ] || { [ -z "${session-${CODEX_DECK_SESSION-}}" ] && [ -z "${CODEX_THREAD_ID-}" ]; }; }; then
    URL=$fallback_url; TOKEN=${DECK_TOKEN-$fallback_token}; SELECTED_INSTANCE=$fallback_id
  elif [ "$live" -eq 0 ]; then
    echo 'deck-api: 没有可达的 Deck 实例；请启动 Deck，检查 Windows/WSL 网络，或显式设置 DECK_API_URL 与 DECK_TOKEN' >&2; return 2
  else
    echo 'deck-api: 无法唯一确定当前会话所属后端（多个 Deck 实例或来源不匹配）；请用 --session 或 DECK_INSTANCE_ID 指定' >&2; return 2
  fi
}

# api METHOD PATH [BODY] —— 成功打印响应体；失败打印原因到 stderr 并返回非 0
# （接口不存在返回 4，便于对旧版 Deck 回退）。
api() {
  discover || return $?
  [ -n "$URL" ] || { echo "deck-api: 找不到 Deck 地址（Deck 未启动过？可设置 DECK_SEND_URL）" >&2; return 2; }
  local args=(-sS --connect-timeout 10 --max-time 120 -X "$1" "$URL$2" -H "Content-Type: application/json" -w $'\n%{http_code}')
  [ -n "$TOKEN" ] && args+=(-H "Authorization: Bearer $TOKEN")
  [ $# -ge 3 ] && args+=(--data-binary "$3")
  local out code err
  if ! out=$(curl "${args[@]}"); then
    if [ "${DECK_API_RETRY_SAFE-}" = 1 ]; then
      out=$(curl "${args[@]}") || { echo 'deck-api: 网络请求失败；使用原 requestId 重放，不要重建任务' >&2; return 1; }
    else echo "deck-api: 无法连接 Deck（$URL）" >&2; return 1; fi
  fi
  code=${out##*$'\n'}; out=${out%$'\n'*}
  if [ "$code" = 404 ]; then
    # 404 既可能是接口不存在（旧版 Deck，prepare 用它探测并静默回退），
    # 也可能是收件人解析失败（UNKNOWN_ALIAS）。调用方决定是否吞掉提示：
    # prepare 重定向 stderr；send/result 等必须让用户看到原因，不能静默退出。
    err=$(json_field "$out" error)
    if [ "$2" = /api/deck/receive ] && [ -z "$err" ]; then
      echo 'deck-api: 当前 Deck 不支持 receive，请升级并重启服务；不要使用 collect 替代' >&2
      return 4
    fi
    echo "deck-api: ${err:-Deck 返回 404：$out}" >&2
    return 4
  fi
  if [ "${code:0:1}" != 2 ]; then
    err=$(json_field "$out" error)
    echo "deck-api: ${err:-Deck 返回 $code：$out}" >&2
    return 1
  fi
  printf '%s\n' "$out"
}

check_code() {
  [[ ${1#@} =~ ^s-[a-z0-9]+$ ]] || die "无效会话别名：${1-}"
}

# ask_of_session ALIAS —— 找出指向该会话的询问记录 ID（没有则输出空）。
# 会话别名与会话一一对应，询问回执仍以询问为粒度；两者不能混用。
# pipefail 下 grep 落空会返回非零：末尾加 || true 把“查无”压成空输出，
# 调用方再报“没有关联”；只有 api 本身失败才返回非零。
ask_of_session() {
  local alias=$1 out
  out=$(api GET /api/deck/sessions 2>/dev/null) || return 1
  printf '%s\n' "$out" | tr '{' '\n' | grep -F "\"targetAlias\":\"$alias\"" | head -n1 |
    grep -oE '"id":"[^"]+"' | head -n1 | sed -E 's/^"id":"//; s/"$//' || true
}

# resolve_ask_reference REF —— 把 @s-xxx 会话别名还原成询问记录 ID。
# 询问别名/完整 ID 原样返回；格式不对直接退出，避免把打错的引用发给服务端。
resolve_ask_reference() {
  local reference=${1-}
  reference=${reference#@}
  if [ "${reference:0:2}" = s- ]; then
    [[ $reference =~ ^s-[a-z0-9]{7}$ ]] || die "无效会话别名：@$reference"
    local ask
    ask=$(ask_of_session "$reference") || exit 1
    [ -n "$ask" ] || die "会话 @$reference 没有关联的询问记录"
    reference=$ask
  fi
  [[ $reference =~ ^[a-z0-9-]{8,64}$ ]] || die "用法：deck-api ${cmd} @alias（或完整询问 ID）"
  printf '%s' "$reference"
}

# lifecycle_body SESSION SESSION_EXPLICIT EXTRA_JSON —— 所有权校验与审计用的调用者信息。
lifecycle_body() {
  printf '{"session":%s,"sessionExplicit":%s,"codexThread":%s,"cwd":%s,"pid":%s%s}' \
    "$(json_str "$1")" "$2" "$(json_str "${CODEX_THREAD_ID-}")" "$(json_str "$PWD")" "$PID" "${3-}"
}

# prepare CODE COMMAND FORCE DRY —— 让 Deck 确认/识别目标会话。
# 附带本进程 pid（Deck 据此沿进程树找到发起命令的 agent）、工作目录，
# 以及 agent 自己提供的会话标识（$session 为空则不传；$session_explicit
# 标记它来自 --session 显式参数而非环境变量——后者需进程树佐证）。
prepare() {
  local code_json=null
  [ -n "$1" ] && code_json=$(json_str "$1")
  api POST /api/deck/prepare "$(printf '{"code":%s,"pid":%s,"cwd":%s,"session":%s,"sessionExplicit":%s,"codexThread":%s,"command":%s,"force":%s,"dryRun":%s}' \
    "$code_json" "$PID" "$(json_str "$PWD")" "$(json_str "${session-}")" "${session_explicit:-false}" \
    "$(json_str "${CODEX_THREAD_ID-}")" "$(json_str "$2")" "$3" "$4")"
}

send() { # code text [mode]
  local mode_json=""
  local delivery_mode=${3-${DECK_SEND_MODE-${DECK_WAKE_MODE-}}}
  [ -z "$delivery_mode" ] || mode_json=",\"mode\":$(json_str "$delivery_mode")"
  api POST "/api/deck/events/$1" "{\"text\":$(json_str "$2")$mode_json}" >/dev/null
}

# 当前前台等待的子进程；收到信号时一并结束。
CHILD=""

# 可被信号打断的 sleep（前台 sleep 会让 trap 推迟到它结束）。
nap() {
  sleep "$1" &
  CHILD=$!
  wait "$CHILD"
  CHILD=""
}

# 唤醒必须送达：Deck 重启中也要等它回来。
send_retry() {
  local i
  for i in $(seq 1 20); do
    send "$1" "$2" && { echo "$(date '+%F %T') 已唤醒 $1"; return 0; }
    nap 30
  done
  echo "$(date '+%F %T') 唤醒失败，放弃" >&2
  return 1
}

# USR1 = 主动停止（deck-api stop / Deck 界面）；TERM 等 = 被外部终止，
# Deck 会把后者报为失联。这一行是 Deck 判断 watcher 结局的依据。
on_signal() {
  [ -n "$CHILD" ] && kill "$CHILD" 2>/dev/null
  if [ "$1" = USR1 ]; then
    echo "$(date '+%F %T') 已停止（手动），不再唤醒"
    exit 0
  fi
  echo "$(date '+%F %T') 收到 $1，watcher 退出（未唤醒）"
  exit 143
}

human() {
  local s=$1
  if [ "$s" -ge 3600 ]; then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  elif [ "$s" -ge 60 ]; then printf '%dm%02ds' $((s / 60)) $((s % 60))
  else printf '%ds' "$s"; fi
}

spawn() { # code subcommand args...
  local code=$1
  mkdir -p "$LOG_DIR"
  local log
  log="$LOG_DIR/$code-$(date +%Y%m%d-%H%M%S).log"
  # 同会话别名同一秒内挂两个 watcher 时日志名会撞车（后者会截断前者）：
  # 等到下一秒再取名，保持 `<会话别名>-时间.log` 的命名约定不变。
  while [ -e "$log" ]; do
    sleep 1
    log="$LOG_DIR/$code-$(date +%Y%m%d-%H%M%S).log"
  done
  shift
  if command -v setsid >/dev/null 2>&1; then
    setsid nohup bash "$SELF" "$@" >"$log" 2>&1 </dev/null &
  else
    nohup bash "$SELF" "$@" >"$log" 2>&1 </dev/null &
  fi
  local child=$! shown=$!
  if [ -r "/proc/$child/winpid" ]; then
    local win
    win=$(cat "/proc/$child/winpid" 2>/dev/null || true)
    [ -n "$win" ] && shown=$win
  fi
  echo "watcher 已在后台启动：pid $shown，会话别名 $code，日志 $log"
}

WATCH_TMP=""

run_watch() { # code label lines -- cmd...
  local code=$1 label=$2 lines=$3; shift 4
  local start rc elapsed
  WATCH_TMP=$(mktemp)
  trap 'rm -f "$WATCH_TMP"' EXIT
  start=$(date +%s)
  echo "$(date '+%F %T') 开始：$*"
  "$@" </dev/null >"$WATCH_TMP" 2>&1 &
  CHILD=$!
  wait "$CHILD"; rc=$?
  CHILD=""
  elapsed=$(( $(date +%s) - start ))
  echo "$(date '+%F %T') 结束：exit=$rc，用时 $(human "$elapsed")"
  send_retry "$code" "$(printf '[%s] 命令结束 exit=%s，用时 %s\n$ %s\n--- 输出末 %s 行 ---\n%s' \
    "$label" "$rc" "$(human "$elapsed")" "$*" "$lines" "$(tail -n "$lines" "$WATCH_TMP")")"
}

run_poll() { # code label interval done_re all -- cmd...
  local code=$1 label=$2 interval=$3 done_re=$4 all=$5; shift 6
  local prev="" state out rc fails=0
  shopt -s nocasematch
  echo "$(date '+%F %T') 开始轮询（${interval}s）：$*"
  while :; do
    out=$("$@" </dev/null 2>/dev/null); rc=$?
    if [ "$rc" -eq 255 ]; then
      fails=$((fails + 1))
      echo "$(date '+%F %T') 连接失败（$fails/10）"
      if [ "$fails" -ge 10 ]; then
        send_retry "$code" "[$label] watcher 连续 10 次无法连接远端，已退出。最后状态：${prev:-未知}。命令：$*"
        exit 1
      fi
      nap "$interval"; continue
    fi
    fails=0
    state=$(printf '%s\n' "$out" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -m1 . || true)
    state=${state:-GONE}
    if [ "$state" != "$prev" ]; then
      echo "$(date '+%F %T') 状态：${prev:-（初始）} -> $state"
      if [[ $state =~ $done_re ]]; then
        send_retry "$code" "[$label] 任务结束：${prev:-（初始）} -> $state"
        exit 0
      fi
      [ "$all" = 1 ] && [ -n "$prev" ] && send_retry "$code" "[$label] 状态变化：$prev -> $state"
      prev=$state
    fi
    nap "$interval"
  done
}

json_output=false
if [ "${1-}" = --json ]; then json_output=true; shift; fi
cmd=${1:-help}; shift || true
if [ "$cmd" = wake ]; then
  case "${1-}" in watch|poll|ps|stop) cmd=$1; shift ;; *) cmd=watch ;; esac
fi
if [ "$json_output" = true ]; then
  case "$cmd" in create|ask|send|receive|tasks|sessions|asks|agents|presets|result|inspect|wait|collect|delivery) ;;
    *) die "该命令未提供 --json 模式" ;;
  esac
fi
if [ "${1-}" = --help ]; then usage "${cmd-}"; exit 0; fi
case "$cmd" in
  presets)
    [ $# -eq 0 ] || die "用法：deck-api presets"
    api GET /api/deck/presets
    ;;
  agents|asks|sessions|tasks)
    endpoint=/api/deck/sessions; unread=false; source=''
    while [ $# -gt 0 ]; do
      case "$1" in
        --unread) unread=true; shift ;;
        --source) source=${2:?缺少来源}; shift 2 ;;
        *) die "未知参数 $1" ;;
      esac
    done
    if [ "$cmd" = agents ]; then endpoint=/api/deck/agents
    elif [ "$unread" = true ] || [ -n "$source" ]; then
      endpoint+='?unread='"$unread"
      if [ -n "$source" ]; then endpoint+="&source=$(url_encode "$source")"
      else endpoint+="&source=self&pid=$PID&codexThread=$(url_encode "${CODEX_THREAD_ID-}")&session=$(url_encode "${CODEX_DECK_SESSION-}")"; fi
    fi
    api GET "$endpoint"
    ;;
  ask|create)
    if [ "${1-}" = --help ]; then usage create; exit 0; fi
    target=''; preset=''
    if [ $# -gt 0 ] && [[ "$1" != -* ]]; then target=$1; shift; fi
    mode=queue; detached=false; provider=''; model=''; effort=''; name=''; file=''; target_cwd=''; worktree=''; sandbox=''; approval=''; permission=''; request_id=''
    session=${CODEX_DECK_SESSION-}; session_explicit=false
    while [ $# -gt 0 ]; do
      case "$1" in
        --mode) mode=${2:?缺少 mode}; shift 2 ;;
        --detached) detached=true; shift ;;
        --cwd) target_cwd=${2:?缺少目录}; shift 2 ;;
        --worktree) worktree=head; shift ;;
        --worktree=*) worktree=${1#*=}; [ -n "$worktree" ] || die "缺少 base"; shift ;;
        --sandbox) sandbox=${2:?缺少 sandbox}; shift 2 ;;
        --approval) approval=${2:?缺少 approval}; shift 2 ;;
        --permission-mode) permission=${2:?缺少 permissionMode}; shift 2 ;;
        --request-id) request_id=${2:?缺少 request-id}; shift 2 ;;
        --preset) preset=${2:?缺少预设名}; shift 2 ;;
        --provider) provider=${2:?缺少 provider}; shift 2 ;;
        --model) model=${2:?缺少 model}; shift 2 ;;
        --effort) effort=${2:?缺少 effort}; shift 2 ;;
        --session) session=${2:?缺少 session}; session_explicit=true; shift 2 ;;
        --name) name=${2:?缺少 name}; shift 2 ;;
        --file) file=${2:?缺少 file}; shift 2 ;;
        --) shift; break ;;
        -*) echo "deck-api: 未知参数 $1" >&2; exit 1 ;;
        *) break ;;
      esac
    done
    [ -n "$target" ] || [ -n "$preset" ] || die "缺少目标 agentId 或 --preset"
    if [ -n "$preset" ] && { [ -n "$provider" ] || [ -n "$model" ] || [ -n "$effort" ]; }; then
      die "预设不能与 --provider / --model / --effort 同时使用"
    fi
    question=$*
    if [ -n "$file" ]; then
      [ -z "$question" ] || { echo 'deck-api: --file 与问题参数不能同时使用' >&2; exit 1; }
      if [ "$file" = - ]; then question=$(cat); else question=$(cat -- "$file"); fi
    fi
    [ -n "$question" ] || { echo 'deck-api: 缺少问题' >&2; exit 1; }
    case "$mode" in queue|steer|interrupt) ;; *) echo 'deck-api: mode 应为 queue、steer 或 interrupt' >&2; exit 1 ;; esac
    body=$(printf '{"targetAgentId":%s,"returnMode":%s,"detached":%s,"providerId":%s,"model":%s,"reasoningEffort":%s,"name":%s,"session":%s,"sessionExplicit":%s,"codexThread":%s,"cwd":%s,"pid":%s,"question":%s}' \
      "$(json_str "$target")" "$(json_str "$mode")" "$detached" "$(json_str "$provider")" "$(json_str "$model")" \
      "$(json_str "$effort")" "$(json_str "$name")" "$(json_str "$session")" "$session_explicit" \
      "$(json_str "${CODEX_THREAD_ID-}")" "$(json_str "$PWD")" "$PID" "$(json_str "$question")")
    extra=''
    if [ -n "$preset" ]; then
      extra+=",\"preset\":$(json_str "$preset")"
      # An omitted Agent is resolved by the server from the preset.
      if [ -z "$target" ]; then body=${body/\"targetAgentId\":\"\",/}; fi
    fi
    [ -z "$target_cwd" ] || extra+=",\"targetCwd\":$(json_str "$target_cwd")"
    [ -z "$worktree" ] || extra+=",\"worktree\":{\"base\":$(json_str "$worktree")}"
    permissions=''; sep=''
    for key in sandbox approvalPolicy permissionMode; do
      case "$key" in sandbox) value=$sandbox ;; approvalPolicy) value=$approval ;; permissionMode) value=$permission ;; esac
      if [ -n "$value" ]; then permissions+="$sep$(json_str "$key"):$(json_str "$value")"; sep=,; fi
    done
    body="${body%?}$extra,\"permissions\":{$permissions}}"
    [ -n "$request_id" ] || request_id=$(new_request_id)
    echo "requestId: $request_id" >&2
    body="${body%?},\"protocol\":2,\"requestId\":$(json_str "$request_id") }"
    DECK_API_RETRY_SAFE=1 api POST /api/deck/create "$body" || exit 1
    if [ "$detached" = true ]; then
      echo '后台会话已创建；最终结果进入收件箱但不单独唤醒，用 receive 领取。' >&2
    else
      echo '会话已创建；可继续当前工作，用 receive 领取来信与自动最终结果。' >&2
    fi
    ;;
  collect)
    [ $# -gt 0 ] || die "用法：deck-api collect @alias [@alias ...]"
    refs=''; separator=''
    for ref in "$@"; do
      reference=$(resolve_ask_reference "$ref") || exit 1
      refs+="$separator$(json_str "$reference")"; separator=,
    done
    api POST /api/deck/collect "{\"references\":[$refs]}" || exit 1
    ;;
  delivery)
    delivery_id=${1:?缺少投递 ID}
    [[ $delivery_id =~ ^[a-zA-Z0-9:_-]{1,200}$ ]] || die "无效投递 ID"
    [ $# -eq 1 ] || die "用法：deck-api delivery <deliveryId>"
    api GET "/api/deck/deliveries/$delivery_id" || exit 1
    ;;
  result|inspect|wait)
    reference=$(resolve_ask_reference "${1-}") || exit 1
    shift
    tail=40; timeout=60
    while [ $# -gt 0 ]; do
      case "$1" in
        --timeout) [ "$cmd" = wait ] || die "--timeout 仅用于 wait"; timeout=${2:?缺少秒数}; shift 2 ;;
        --tail) [ "$cmd" = inspect ] || die "--tail 仅用于 inspect"; tail=${2:?缺少行数}; shift 2 ;;
        *) die "未知参数 $1" ;;
      esac
    done
    [[ $tail =~ ^[0-9]{1,3}$ ]] && [ "$tail" -ge 1 ] && [ "$tail" -le 200 ] || die "tail 应为 1 至 200 的整数"
    endpoint="/api/deck/sessions/$reference/$cmd"
    [ "$cmd" != inspect ] || endpoint+="?tail=$tail"
    if [ "$cmd" = wait ]; then
      [[ $timeout =~ ^[0-9]{1,2}$ ]] && [ "$timeout" -le 60 ] || die "timeout 应为 0 至 60 秒的整数"
      endpoint="/api/deck/sessions/$reference/result?wait=$timeout"
    fi
    api GET "$endpoint" || exit 1
    ;;
  whoami)
    session=${CODEX_DECK_SESSION-}; session_explicit=false
    out=$(prepare "" "" false true) || exit 1
    json_field "$out" summary
    ;;
  list)
    # 列出询问引用与默认会话别名（send/result 可直接用 @s-xxxxxxx）。
    out=$(api GET /api/deck/sessions) || exit 1
    if command -v jq >/dev/null 2>&1; then
      printf '%s' "$out" | jq -r '.items[] | [.alias, (.targetAlias // "-"), .targetAgentId, .status] | @tsv'
      out=$(api GET /api/deck/targets) || exit 1
      printf '%s' "$out" | jq -r '.items[] | [.alias, "-", .agentId, (.status // "-")] | @tsv'
    else
      printf '%s\n' "$out"
    fi
    ;;
  receive)
    wait_seconds=0; replay=''; request_id=''
    session=${CODEX_DECK_SESSION-}; session_explicit=false
    while [ $# -gt 0 ]; do
      case "$1" in
        --wait) wait_seconds=${2:?缺少等待秒数}; shift 2 ;;
        --request-id) request_id=${2:?缺少 request-id}; shift 2 ;;
        --session) session=${2:?缺少当前会话}; session_explicit=true; shift 2 ;;
        --replay)
          replay=true; shift
          if [ $# -gt 0 ] && [[ $1 != --* ]]; then replay=$1; shift; fi ;;
        *) die "未知参数 $1" ;;
      esac
    done
    [[ $wait_seconds =~ ^[0-9]+$ ]] && [ "$wait_seconds" -le 60 ] || die 'wait 应为 0 至 60 秒整数'
    [ -n "$request_id" ] || request_id=$(new_request_id)
    echo "requestId: $request_id" >&2
    body=$(printf '{"protocol":2,"requestId":%s,"wait":%s,"session":%s,"sessionExplicit":%s,"codexThread":%s,"cwd":%s,"pid":%s' \
      "$(json_str "$request_id")" "$((10#$wait_seconds))" "$(json_str "$session")" "$session_explicit" "$(json_str "${CODEX_THREAD_ID-}")" "$(json_str "$PWD")" "$PID")
    if [ "$replay" = true ]; then body+=',"replay":true'
    elif [ -n "$replay" ]; then body+=",\"replay\":$(json_str "$replay")"; fi
    body+='}'
    DECK_API_RETRY_SAFE=1 api POST /api/deck/receive "$body"
    ;;
  send)
    mode=''; to=''; file=''; request_id=''
    session=${CODEX_DECK_SESSION-}; session_explicit=false
    # Legacy deck-send send <code> <text> syntax is intentionally handled by the compatibility entry.
    while [ $# -gt 0 ]; do
      case "$1" in
        --mode) mode=${2:?缺少 mode}; shift 2 ;;
        --to) to=${2:?缺少目标会话}; shift 2 ;;
        --code) die "--code 已移除，请用 --to @s-…" ;;
        --session) session=${2:?缺少当前会话}; session_explicit=true; shift 2 ;;
        --request-id) request_id=${2:?缺少 request-id}; shift 2 ;;
        --file) file=${2:?缺少 file}; shift 2 ;;
        --help) usage send; exit 0 ;;
        --) shift; break ;;
        -*) die "未知参数 $1" ;;
        *) die "send 不接受位置参数：$1（消息要放在 -- 之后；发给指定会话别名用 --to @s-…）" ;;
      esac
    done
    [ -z "$mode" ] || case "$mode" in queue|steer|interrupt) ;; *) die "mode 应为 queue、steer 或 interrupt" ;; esac
    if [ "${to:0:3}" = @s- ]; then
      # 会话别名直接交给服务端解析；这里只做格式校验，避免把打错的别名当收件人。
      [[ $to =~ ^@s-[a-z0-9]{7}$ ]] || die "无效会话别名：$to"
    fi
    text=$*
    if [ -n "$file" ]; then
      [ -z "$text" ] || die "--file 与消息参数不能同时使用"
      if [ "$file" = - ]; then text=$(cat); else text=$(cat -- "$file") || exit 1; fi
    fi
    [ -n "$text" ] || die "缺少消息内容"
    body=$(printf '{"text":%s,"session":%s,"sessionExplicit":%s,"codexThread":%s,"cwd":%s,"pid":%s' \
      "$(json_str "$text")" "$(json_str "$session")" "$session_explicit" \
      "$(json_str "${CODEX_THREAD_ID-}")" "$(json_str "$PWD")" "$PID")
    [ -z "$mode" ] || body+=",\"mode\":$(json_str "$mode")"
    [ -z "$to" ] || body+=",\"to\":$(json_str "$to")"
    [ -n "$request_id" ] || request_id=$(new_request_id)
    echo "requestId: $request_id" >&2
    body+=",\"requestId\":$(json_str "$request_id")"
    if [ -z "$mode" ] || [ "$mode" = queue ]; then body+=',"protocol":2'; fi
    body+="}"
    retry_safe=0
    if [ -z "$mode" ] || [ "$mode" = queue ]; then retry_safe=1; fi
    resp=$(DECK_API_RETRY_SAFE=$retry_safe api POST /api/deck/send "$body") || exit 1
    if [ "$json_output" = true ]; then printf '%s\n' "$resp"; exit 0; fi
    # 2xx 只代表持久受理；使用 deliveryId 查询单条消息的真实投递状态。
    delivery_id=$(json_field "$resp" deliveryId)
    [ -n "$delivery_id" ] || delivery_id=$(json_field "$resp" id)
    mid=$(json_field "$resp" messageId)
    [ -n "$mid" ] || mid=$(json_field "$resp" id)
    if [ -z "$delivery_id" ]; then printf '%s\n' "$resp"
    elif [ -n "$mid" ]; then
      echo "消息已持久受理：messageId $mid；deliveryId $delivery_id（受理≠送达，用 deck-api delivery $delivery_id 查询）"
    else
      echo '消息已持久受理，将按投递方式发送。'
    fi
    ;;
  stop|kill)
    # 兼容旧入口：`deck-api stop <pid>` 仍按 watcher 处理；会话停止用 @alias。
    if [[ ${1-} =~ ^[0-9]+$ ]]; then
      pid=$1
      if api POST "/api/monitor/watchers/$pid/stop" '{}' >/dev/null 2>&1; then
        echo "已停止 watcher $pid"
        exit 0
      fi
      args=$(ps -o args= -p "$pid" 2>/dev/null) || die "进程 $pid 不存在"
      [[ $args =~ deck-(api|send|wake)\ _(watch|poll) ]] || die "pid $pid 不是 deck-api watcher"
      kill -USR1 -- "-$pid" 2>/dev/null || kill -USR1 "$pid" || die "无法停止 $pid"
      echo "已停止 watcher $pid"
      exit 0
    fi
    ref=${1-}
    [ -n "$ref" ] || die "用法：deck-api stop @alias [--after-turn|--now|--force]"
    shift
    mode=now; force=false
    session=${CODEX_DECK_SESSION-}; session_explicit=false
    while [ $# -gt 0 ]; do
      case "$1" in
        --after-turn) mode=after-turn; shift ;;
        --now) mode=now; shift ;;
        --force) force=true; shift ;;
        --session) session=${2:?缺少 session}; session_explicit=true; shift 2 ;;
        --) shift; break ;;
        *) die "未知参数 $1" ;;
      esac
    done
    reference=$(resolve_ask_reference "$ref") || exit 1
    body=$(lifecycle_body "$session" "$session_explicit" ",\"mode\":$(json_str "$mode"),\"force\":$force")
    api POST "/api/deck/sessions/$reference/stop" "$body" || exit 1
    ;;
  delete|del)
    ref=${1-}
    [ -n "$ref" ] || die "用法：deck-api delete @alias [--force] [--keep-worktree] [--keep-watchers]"
    shift
    force=false; keep_worktree=false; keep_watchers=false; close_connection=false
    session=${CODEX_DECK_SESSION-}; session_explicit=false
    while [ $# -gt 0 ]; do
      case "$1" in
        --force) force=true; shift ;;
        --keep-worktree) keep_worktree=true; shift ;;
        --keep-watchers) keep_watchers=true; shift ;;
        --close-connection) close_connection=true; shift ;;
        --session) session=${2:?缺少 session}; session_explicit=true; shift 2 ;;
        --) shift; break ;;
        *) die "未知参数 $1" ;;
      esac
    done
    reference=$(resolve_ask_reference "$ref") || exit 1
    body=$(lifecycle_body "$session" "$session_explicit" \
      ",\"force\":$force,\"keepWorktree\":$keep_worktree,\"keepWatchers\":$keep_watchers,\"closeConnection\":$close_connection")
    api DELETE "/api/deck/sessions/$reference" "$body" || exit 1
    ;;
  archive|unarchive)
    ref=${1-}
    [ -n "$ref" ] || die "用法：deck-api $cmd @alias"
    shift
    force=false
    session=${CODEX_DECK_SESSION-}; session_explicit=false
    while [ $# -gt 0 ]; do
      case "$1" in
        --force) force=true; shift ;;
        --session) session=${2:?缺少 session}; session_explicit=true; shift 2 ;;
        --) shift; break ;;
        *) die "未知参数 $1" ;;
      esac
    done
    reference=$(resolve_ask_reference "$ref") || exit 1
    body=$(lifecycle_body "$session" "$session_explicit" ",\"force\":$force")
    api POST "/api/deck/sessions/$reference/$cmd" "$body" || exit 1
    ;;
  watch|poll)
    code=""
    if [ $# -gt 0 ] && [ "${1:0:1}" != "-" ]; then
      check_code "$1"; code=${1#@}; shift
    fi
    label=""; lines=40; interval=60; done_re=$DONE_RE_DEFAULT; all=0; force=false; delivery_mode=queue
    session=${CODEX_DECK_SESSION-}; session_explicit=false
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do
      case "$1" in
        --mode) delivery_mode=${2:?缺少 mode}; shift 2
          case "$delivery_mode" in queue|steer|interrupt) ;; *) die "mode 应为 queue、steer 或 interrupt" ;; esac ;;
        --session) session=${2:?缺少 session}; session_explicit=true; shift 2 ;;
        -l) label=${2:?缺少 label}; shift 2 ;;
        -n) lines=${2:?缺少行数}; shift 2 ;;
        -i) interval=${2:?缺少间隔秒数}; shift 2 ;;
        -d) done_re=${2:?缺少结束态正则}; shift 2 ;;
        -a) all=1; shift ;;
        -f) force=true; shift ;;
        *) die "未知参数：$1（命令前需要 --）" ;;
      esac
    done
    case "$lines" in ''|*[!0-9]*) die "行数应为非负整数：$lines" ;; esac
    case "$interval" in ''|*[!0-9]*) die "轮询间隔应为正整数秒：$interval" ;; esac
    [ "$interval" -ge 5 ] || die "轮询间隔至少 5 秒（当前 $interval）"
    [ "${1-}" = "--" ] || die "缺少 -- <command...>"
    shift
    [ $# -gt 0 ] || die "缺少要运行的命令"
    resp=$(prepare "$code" "$*" "$force" false); rc=$?
    if [ "$rc" -eq 4 ]; then
      # 旧版 Deck 没有 prepare 接口：只能按显式会话别名挂载。
      [ -n "$code" ] || die "当前 Deck 版本不能自动识别会话，请提供会话别名"
      api GET "/api/deck/events/$code" >/dev/null || exit 1
    elif [ "$rc" -ne 0 ]; then
      exit 1
    else
      code=$(json_field "$resp" code)
      [[ $code =~ $CODE_RE ]] || die "Deck 未返回有效会话别名：$resp"
      summary=$(json_field "$resp" summary)
      warning=$(json_field "$resp" warning)
      [ -n "$summary" ] && echo "$summary"
      [ -n "$warning" ] && echo "注意：$warning" >&2
    fi
    discover || exit $?
    export DECK_INSTANCE_ID="$SELECTED_INSTANCE"
    label=${label:-$code}
    export DECK_SEND_MODE="$delivery_mode"
    if [ "$cmd" = watch ]; then
      spawn "$code" _watch "$code" "$label" "$lines" -- "$@"
    else
      spawn "$code" _poll "$code" "$label" "$interval" "$done_re" "$all" -- "$@"
    fi
    ;;
  _watch|_poll)
    trap 'on_signal USR1' USR1
    trap 'on_signal TERM' TERM
    trap 'on_signal INT' INT
    if [ "$cmd" = _watch ]; then run_watch "$@"; else run_poll "$@"; fi
    ;;
  ps)
    ps -eo pid,etime,args | grep -E '[d]eck-(api|send|wake) _(watch|poll)' || echo "没有运行中的 watcher"
    ;;
  help|-h|--help) usage "$@" ;;
  *) usage; exit 1 ;;
esac
