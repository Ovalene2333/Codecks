{
  "name": "codex-deck",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first web console for Codex, Claude Code, OpenCode and ACP agents: remote chat, approvals, multi-provider sessions, agent collaboration and task wake-ups.",
  "keywords": [
    "codex",
    "claude-code",
    "opencode",
    "acp",
    "ai-agents",
    "remote-console",
    "self-hosted"
  ],
  "license": "MIT",
  "repository": "https://github.com/Ovalene2333/Codecks",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --experimental-sqlite --import tsx --watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "start": "node --experimental-sqlite dist-server/server/index.js",
    "lan": "node --experimental-sqlite dist-server/server/index.js --lan",
    "lan6": "node --experimental-sqlite dist-server/server/index.js --lan6",
    "cf-tunnel": "node --experimental-sqlite dist-server/server/index.js --cf-tunnel",
    "share": "node --experimental-sqlite dist-server/server/index.js --share",
    "test": "node --experimental-sqlite --import tsx --test server/*.test.ts server/**/*.test.ts src/*.test.ts src/**/*.test.ts plugin/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "compression": "^1.8.1",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "node-pty": "1.2.0-beta.15",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
