{
  "name": "codex-deck",
  "version": "0.1.0",
  "private": true,
  "description": "A mobile-first remote console for Codex CLI.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/index.js",
    "lan": "node dist-server/index.js --lan",
    "cf-tunnel": "node dist-server/index.js --cf-tunnel",
    "share": "node dist-server/index.js --share",
    "test": "node --import tsx --test server/**/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
