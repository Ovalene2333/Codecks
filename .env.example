# Copy this file to .env and fill in only what you need.
# Never commit .env.

# HOST=127.0.0.1
# PORT=4174
# REMOTE_TOKEN=

# CODEX_BIN=codex
# CODEX_WSL_BIN=codex
# CODEX_WSL_SHELL=bash
# CODEX_WSL_HOME=
# CODEX_DECK_RUNTIME_PORT=

# CLAUDE_CONFIG_DIR=
# CLAUDE_BIN=
# OPENCODE_BIN=opencode

# DATA_DIR=.data
# CC_SWITCH_DB=

# CODEX_DECK_EXPOSE=
# CODEX_DECK_PUBLIC_ORIGIN=
# PUBLIC_ORIGIN=
# CODEX_DECK_TUNNEL_BIN=
# CODEX_DECK_TUNNEL_ARGS=
# CODEX_DECK_TUNNEL_URL_PATTERN=

# CODEX_DECK_CLOUDFLARED=
# CODEX_DECK_TUNNEL_PROTOCOL=http2

# --- IPv6 ---
# 监听所有 IPv6 网卡（双栈）：--lan6，或 HOST=::

# --- DDNS（--expose ddns:duckdns / ddns:cloudflare）---
# DDNS_HOST=mydeck.duckdns.org
# DDNS_TOKEN=
# DDNS_ZONE=            # cloudflare 必填：Zone ID
# DDNS_IPV4=none        # auto | none | 具体 IPv4
# DDNS_IPV6=auto        # auto | none | 具体 IPv6
# DDNS_INTERVAL=10      # 更新间隔（分钟）

# Required for `npm run share` / `--share` / `--expose cloudflare:share`
CF_TUNNEL_TOKEN=
CF_TUNNEL_HOSTNAME=
