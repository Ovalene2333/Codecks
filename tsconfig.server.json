{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "types": ["node"],
    "noEmit": false
  },
  "include": [
    "server/**/*.ts",
    "plugin/**/*.server.ts",
    "plugin/**/*.types.ts",
    "plugin/server-registry.ts",
    "plugin/types.ts"
  ],
  "exclude": ["server/**/*.test.ts", "plugin/**/*.test.ts"]
}
